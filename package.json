{
  "name": "jarling",
  "description": "A local-first envelope budgeting app built with Expo.",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CristoJV/jarling.git"
  },
  "homepage": "https://github.com/CristoJV/jarling#readme",
  "bugs": {
    "url": "https://github.com/CristoJV/jarling/issues"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "^1.8.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.15",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "expo-doctor": "^1.20.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:debug:prebuild": "APP_VARIANT=development expo prebuild --clean --platform android",
    "android:debug": "APP_VARIANT=development expo run:android",
    "android:release:local:prebuild": "APP_VARIANT=production expo prebuild --clean --platform android",
    "android:release:local": "APP_VARIANT=production expo run:android --variant release",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "maestro test .maestro",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/domain/**/*.{ts,tsx}",
      "src/application/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/application/application-services.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 75,
        "lines": 75,
        "statements": 75
      }
    },
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/android/"
    ]
  },
  "private": true
}
